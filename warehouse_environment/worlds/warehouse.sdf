    <model name="wall_north"><static>true</static><pose>0 7.5 1.75 0 0 0</pose><link name="link"><collision name="c"><geometry><box><size>18.5 0.25 3.5</size></box></geometry></collision><visual name="v"><geometry><box><size>18.5 0.25 3.5</size></box></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.65 0.67 0.70 1</diffuse></material></visual></link></model>
