<?xml version="1.0"?>
<sdf version="1.8">
  <world name="warehouse">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="libgz-sim-physics-system.so"/>
    <plugin name="gz::sim::systems::UserCommands" filename="libgz-sim-user-commands-system.so"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="libgz-sim-scene-broadcaster-system.so"/>
    <plugin name="gz::sim::systems::Sensors" filename="libgz-sim-sensors-system.so">
      <render_engine>ogre2</render_engine>
    </plugin>
    <gravity>0 0 -9.81</gravity>

    <scene>
      <ambient>0.25 0.25 0.25 1</ambient>
      <background>0.08 0.10 0.14 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- Practical warehouse lighting -->
    <light name="ceiling_1" type="point"><pose>-6 -3 5.8 0 0 0</pose><intensity>1</intensity><cast_shadows>true</cast_shadows><attenuation><range>10</range></attenuation></light>
    <light name="ceiling_2" type="point"><pose>0 -3 5.8 0 0 0</pose><intensity>1</intensity><cast_shadows>true</cast_shadows><attenuation><range>10</range></attenuation></light>
    <light name="ceiling_3" type="point"><pose>6 -3 5.8 0 0 0</pose><intensity>1</intensity><cast_shadows>true</cast_shadows><attenuation><range>10</range></attenuation></light>
    <light name="ceiling_4" type="point"><pose>-6 3 5.8 0 0 0</pose><intensity>1</intensity><cast_shadows>true</cast_shadows><attenuation><range>10</range></attenuation></light>
    <light name="ceiling_5" type="point"><pose>0 3 5.8 0 0 0</pose><intensity>1</intensity><cast_shadows>true</cast_shadows><attenuation><range>10</range></attenuation></light>
    <light name="ceiling_6" type="point"><pose>6 3 5.8 0 0 0</pose><intensity>1</intensity><cast_shadows>true</cast_shadows><attenuation><range>10</range></attenuation></light>

    <!-- 18 x 14 m warehouse floor -->
    <model name="ground"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>20 16</size></plane></geometry><material><ambient>0.32 0.34 0.36 1</ambient><diffuse>0.18 0.22 0.28 1</diffuse></material></visual>
    </link></model>

